        {
          "scene_id": "explain_rule",
          "start": 8,
          "duration": 8,
          "type": "explanation",
          "text": "Questions: VERB before SUBJECT. Always.",
          "voice_line": "Here is the rule. In English questions, the auxiliary verb comes before the subject. Not: you ARE coming. But: ARE you coming? Not: she HAS finished. But: HAS she finished? Flip them. Always.",
          "tone": "calm",
          "stickman_action": "flip_cards_gesture",
          "stickman_emotion": "explaining",
          "visual": {
            "template": "stickman",
            "background_color": "#16213e",
            "text_color": "#ffffff",
