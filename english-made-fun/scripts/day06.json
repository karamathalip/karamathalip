      "topic": "You are coming? vs Are you coming? — question word order",
      "hook": "English questions have a specific word order. Get it wrong and you sound like you are making a statement, not asking a question.",
      "total_duration_seconds": 39,
      "scenes": [
        {
          "scene_id": "hook",
          "start": 0,
          "duration": 3,
          "type": "hook",
          "text": "English questions have a strict word order. Most learners ignore it.",
          "voice_line": "English questions have a very specific word order. Ignore it and you sound confused — even when people can understand you.",
          "tone": "energetic",
          "stickman_action": "confused_head_tilt",
          "stickman_emotion": "shocked",
          "visual": {
            "template": "text_burst",
