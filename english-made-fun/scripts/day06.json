              "question": "ARE you coming?",
              "arrow": "flip ↔"
            },
            "animation": { "in": "fade", "emphasis": "flip_animation", "out": "fade" }
          },
          "sfx_prompts": ["whoosh_slide"],
          "use_image": false,
          "visual_priority": "standard"
        },
        {
