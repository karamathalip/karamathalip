      "video_id": "vid_011",
      "format": "fail_fix_stickman_skit",
      "topic": "You are coming? vs Are you coming? — question word order",
      "hook": "English questions have a specific word order. Get it wrong and you sound like you are making a statement, not asking a question.",
      "total_duration_seconds": 36,
      "scenes": [
        {
          "scene_id": "hook",
          "start": 0,
          "duration": 3,
          "type": "hook",
          "text": "\"You are coming?\" is NOT a question.",
          "voice_line": "You are coming to the party? <break time=\"0.5s\"/> That is <emphasis level=\"strong\">not</emphasis> a question. Every native speaker just noticed.",
          "tone": "energetic",
          "stickman_action": "confused_head_tilt",
          "stickman_emotion": "shocked",
          "visual": {
            "template": "text_burst",
            "background_color": "#1a1a2e",
            "text_color": "#ff4757",
            "main_text": "WORD ORDER",
            "sub_text": "matters in questions!",
            "animation": {
              "in": "zoom_punch",
              "emphasis": "shake",
              "out": "fade"
            }
          },
          "sfx_prompts": [
            "fail_boop",
            "whoosh_slide"
          ],
          "use_image": false,
          "visual_priority": "high_emotion"
        },
        {
          "scene_id": "fail_demo",
          "start": 3,
          "duration": 5,
          "type": "example",
          "text": "❌ You are coming to the party?",
          "voice_line": "You texted: You are coming to the party? That is a statement with a question mark. Native speakers notice. It feels lazy and unnatural.",
          "tone": "serious",
          "stickman_action": "trip_and_fall",
          "stickman_emotion": "embarrassed",
          "visual": {
            "template": "dialogue",
            "background_color": "#2d1b1b",
            "text_color": "#ffffff",
            "speech_bubble": "You are coming to the party?",
            "highlight_color": "#ff4757",
            "wrong_word_order": true,
            "animation": {
              "in": "slide_up",
              "emphasis": "highlight_word",
              "out": "slide_left"
            },
            "transition": "moody_problem_state"
          },
          "sfx_prompts": [
            "trip_whoosh",
            "fall_thud"
          ],
          "use_image": false,
          "visual_priority": "standard"
        },
        {
          "scene_id": "explain_rule",
          "start": 8,
          "duration": 8,
          "type": "explanation",
          "text": "Questions: VERB before SUBJECT. Always.",
          "voice_line": "Here is the rule. <break time=\"0.3s\"/> In English questions, the auxiliary verb comes before the subject. Not: you <emphasis level=\"strong\">ARE</emphasis> coming. But: <emphasis level=\"strong\">ARE</emphasis> you coming? Not: she <emphasis level=\"strong\">HAS</emphasis> finished. But: <emphasis level=\"strong\">HAS</emphasis> she finished? Flip them. Always.",
          "tone": "calm",
          "stickman_action": "flip_cards_gesture",
          "stickman_emotion": "explaining",
          "visual": {
            "template": "stickman",
            "background_color": "#16213e",
            "text_color": "#ffffff",
            "flip_visual": {
              "statement": "You ARE coming.",
              "question": "ARE you coming?",
              "arrow": "flip ↔"
            },
            "animation": {
              "in": "fade",
              "emphasis": "flip_animation",
              "out": "fade"
            }
          },
          "sfx_prompts": [
            "whoosh_slide"
          ],
          "use_image": false,
          "visual_priority": "standard"
        },
        {
          "scene_id": "fix_demo",
          "start": 16,
          "duration": 5,
          "type": "payoff",
          "text": "✅ Are you coming to the party?",
          "voice_line": "<break time=\"0.5s\"/> Now <break time=\"0.5s\"/> say it right. <emphasis level=\"strong\">ARE</emphasis> you coming to the party? <emphasis level=\"strong\">ARE</emphasis> flips to the front. Clean. Correct. Natural English question.",
          "tone": "energetic",
          "stickman_action": "fist_pump",
          "stickman_emotion": "triumphant",
          "visual": {
            "template": "superpower",
            "background_color": "#0f3460",
            "text_color": "#ffffff",
            "highlight_word": "Are",
            "highlight_color": "#2ed573",
            "fixed_sentence": "Are you coming to the party?",
            "animation": {
              "in": "zoom_punch",
              "emphasis": "confetti_burst",
              "out": "fade"
            },
            "transition": "dark_to_bright_reveal"
          },
          "sfx_prompts": [
            "victory_chime",
            "sparkle_pop"
          ],
          "use_image": false,
          "visual_priority": "high_emotion"
        },
        {
          "scene_id": "more_examples",
          "start": 21,
          "duration": 6,
          "type": "example",
          "text": "Does she know? Have they left? Will it rain?",
          "voice_line": "More examples. Does she know? Not: she does know? Have they left? Not: they have left? Will it rain? Not: it will rain? The helper verb always comes first in a question.",
          "tone": "energetic",
          "stickman_action": "count_examples",
          "stickman_emotion": "focused",
          "visual": {
            "template": "text_burst",
            "background_color": "#1a1a2e",
            "text_color": "#ffffff",
            "correct_questions": [
              "Does she know? ✅",
              "Have they left? ✅",
              "Will it rain? ✅"
            ],
            "animation": {
              "in": "slide_up",
              "emphasis": "rapid_reveal",
              "out": "fade"
            }
          },
          "sfx_prompts": [
            "sparkle_pop"
          ],
          "use_image": false,
          "visual_priority": "standard"
        },
        {
          "scene_id": "memory_trick",
          "start": 27,
          "duration": 5,
          "type": "explanation",
          "text": "Memory: Questions lead with the helper. Always.",
          "voice_line": "Memory trick. <break time=\"0.3s\"/> In English, questions are led by the helper verb. <emphasis level=\"strong\">DO</emphasis>, <emphasis level=\"strong\">DID</emphasis>, <emphasis level=\"strong\">DOES</emphasis>, <emphasis level=\"strong\">IS</emphasis>, <emphasis level=\"strong\">ARE</emphasis>, <emphasis level=\"strong\">WAS</emphasis>, <emphasis level=\"strong\">WERE</emphasis>, <emphasis level=\"strong\">HAVE</emphasis>, <emphasis level=\"strong\">HAS</emphasis>, <emphasis level=\"strong\">WILL</emphasis>, <emphasis level=\"strong\">CAN</emphasis>, <emphasis level=\"strong\">SHOULD</emphasis>. These helpers always march to the front of a question.",
          "tone": "warm",
          "stickman_action": "march_gesture",
          "stickman_emotion": "happy",
          "visual": {
            "template": "dialogue",
            "background_color": "#16213e",
            "text_color": "#ffffff",
            "helper_verbs": [
              "DO",
              "DID",
              "IS",
              "ARE",
              "HAVE",
              "HAS",
              "WILL",
              "CAN"
            ],
            "animation": {
              "in": "slide_up",
              "emphasis": "march_reveal",
              "out": "fade"
            }
          },
          "sfx_prompts": [
            "sparkle_pop"
          ],
          "use_image": false,
          "visual_priority": "standard"
        },
