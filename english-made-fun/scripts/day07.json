      "format": "fail_fix_stickman_skit",
      "topic": "I have saw vs I have seen — irregular past participle",
      "hook": "SAW is what you use alone. SEEN always needs HAVE. Most learners mix this up every single day.",
      "total_duration_seconds": 39,
      "scenes": [
        {
          "scene_id": "hook",
          "start": 0,
          "duration": 3,
          "type": "hook",
          "text": "I have SAW. Nope. Never. Here is why. 🚫",
          "voice_line": "I have saw. No. Never. Not once. Not ever. And here is exactly why — plus the fix that sticks forever.",
