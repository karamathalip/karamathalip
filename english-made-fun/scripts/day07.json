          "use_image": false,
          "visual_priority": "standard"
        },
        {
          "scene_id": "explain_saw",
          "start": 8,
          "duration": 7,
          "type": "explanation",
          "text": "SAW = simple past. Alone. It is complete.",
          "voice_line": "SAW is the simple past of SEE. It stands completely alone. I saw the movie. Done. Complete. You do not pair SAW with HAVE. Ever. SAW is the past. It is already finished.",
          "tone": "calm",
          "stickman_action": "firm_point_gesture",
          "stickman_emotion": "serious",
          "visual": {
            "template": "stickman",
            "background_color": "#16213e",
