        {
          "scene_id": "much_rule",
          "start": 16,
          "duration": 7,
          "type": "explanation",
          "text": "Cannot count it? → MUCH",
          "voice_line": "If you CANNOT count it — use MUCH. Much water. You cannot say one water, two waters. Much time. Much love. Much information. No counting — MUCH.",
