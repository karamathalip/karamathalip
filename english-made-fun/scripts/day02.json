        {
          "scene_id": "hero_pose",
          "start": 4,
          "duration": 5,
          "type": "explanation",
          "text": "The superpower: Can you COUNT it?",
          "voice_line": "Your superpower question is this: Can you count it? That is all you need to ask. Can I count this thing? Yes or no. That is the whole rule.",
          "tone": "dramatic",
          "stickman_action": "hero_cape_pose",
          "stickman_emotion": "heroic",
