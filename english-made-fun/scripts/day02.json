          "scene_id": "many_rule",
          "start": 9,
          "duration": 7,
          "type": "explanation",
          "text": "Can count it? → MANY",
          "voice_line": "If you CAN count it — use MANY. Many books. You can count books: one, two, three. Many people. Many days. Many mistakes. Count it — MANY.",
          "tone": "energetic",
          "stickman_action": "count_on_fingers",
          "stickman_emotion": "focused",
          "visual": {
            "template": "stickman",
