        {
          "scene_id": "explain_rule",
          "start": 8,
          "duration": 8,
          "type": "explanation",
          "text": "Short adjective (1-2 syllables): add -ER. Long adjective (3+ syllables): add MORE.",
          "voice_line": "Here is the rule. <break time=\"0.3s\"/> Short adjectives — one or two syllables — add <emphasis level=\"strong\">ER</emphasis>. Tall becomes taller. Fast becomes faster. Old becomes older. Long adjectives — three or more syllables — use <emphasis level=\"strong\">MORE</emphasis>. More beautiful. More interesting. More comfortable. Count the syllables.",
          "tone": "calm",
          "stickman_action": "count_syllables",
          "stickman_emotion": "explaining",
          "visual": {
            "template": "stickman",
            "background_color": "#16213e",
            "text_color": "#ffffff",
            "two_column": {
              "left": {
                "label": "SHORT → -ER",
                "items": [
                  "tall → taller",
                  "fast → faster",
                  "old → older"
                ],
                "color": "#2ed573"
              },
              "right": {
                "label": "LONG → MORE",
                "items": [
                  "beautiful → more beautiful",
                  "interesting → more interesting"
                ],
                "color": "#ffa502"
              }
            },
            "animation": {
              "in": "fade",
              "emphasis": "type_on",
              "out": "fade"
            }
          },
          "sfx_prompts": [
            "whoosh_slide"
          ],
          "use_image": false,
          "visual_priority": "standard"
        },
        {
          "scene_id": "fix_demo",
          "start": 16,
          "duration": 5,
          "type": "payoff",
          "text": "✅ He is TALLER than me.",
          "voice_line": "<break time=\"0.5s\"/> Now <break time=\"0.5s\"/> say it right. Tall — one syllable — so add <emphasis level=\"strong\">ER</emphasis>. He is <emphasis level=\"strong\">TALLER</emphasis> than me. Clean. Correct. Natural.",
